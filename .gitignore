# Logs
*.log
storage/logs/*.log

# Environment files
.env
.env.backup
.env.production

# Cache
.phpunit.result.cache
.phpactor.json
/.phpunit.cache

# IDEs & Editors
.idea/
.vscode/
.zed/
.nova/
.cursor/
.codex/

# OS files
.DS_Store
Thumbs.db

# Dependencies
/vendor/
/node_modules/

# Laravel
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json

/storage/*.key
/storage/pail

# Local-only dev config — never deploy. The Linux server uses its system CA store
# and MySQL; these exist only to make Windows + `php artisan serve` work locally.
/storage/cacert.pem
/storage/php-ini/
/database/*.sqlite

# CMS runtime data. These are edited per environment and should not be pushed.
/storage/app/*.json
/storage/app/*.xlsx
/storage/app/public/*
!/storage/app/public/.gitignore

# Auth
auth.json

# Python scraper virtualenv (country-sync). Created per environment, never committed.
/scripts/.venv

# Helpers
_ide_helper.php

# Homestead
Homestead.yaml
Homestead.json
