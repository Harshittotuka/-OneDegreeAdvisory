<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The PDF suites (dompdf + DejaVu font subsetting) push a full run past
             the 128M default, and PHPUnit then dies with "Premature end of PHP
             process" partway through — reporting only the tests that had already
             passed, which silently hid the rest of the suite. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="CMS_CRM_BACKUP_ENABLED" value="false"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Belt and braces behind AppServiceProvider::sealOutboundMailInTests().
             MAIL_MAILER only covers the DEFAULT mailer, so point every form at
             the array mailer by name too, and strip the SMTP credentials so a
             transport that somehow slipped through has nothing to send with. -->
        <env name="CONTACT_FORM_MAILER" value="array"/>
        <env name="CAREERS_FORM_MAILER" value="array"/>
        <env name="PROFILER_FORM_MAILER" value="array"/>
        <env name="REFERRAL_FORM_MAILER" value="array"/>
        <env name="PAYMENT_SECTION_OTP_MAILER" value="array"/>
        <env name="CRM_MAILER" value="array"/>
        <env name="MAIL_HOST" value="127.0.0.1"/>
        <env name="MAIL_USERNAME" value=""/>
        <env name="MAIL_PASSWORD" value=""/>
        <env name="CONTACT_MAIL_HOST" value="127.0.0.1"/>
        <env name="CONTACT_MAIL_USERNAME" value=""/>
        <env name="CONTACT_MAIL_PASSWORD" value=""/>
        <env name="CAREERS_MAIL_HOST" value="127.0.0.1"/>
        <env name="CAREERS_MAIL_USERNAME" value=""/>
        <env name="CAREERS_MAIL_PASSWORD" value=""/>
        <env name="CRM_MAIL_HOST" value="127.0.0.1"/>
        <env name="CRM_MAIL_USERNAME" value=""/>
        <env name="CRM_MAIL_PASSWORD" value=""/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
