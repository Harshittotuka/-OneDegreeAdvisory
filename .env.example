APP_NAME=One Degree Advisory
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# Rolling CMS + CRM restore points. A successful content/data update creates a
# database + CMS JSON + upload snapshot after the HTTP response is sent. The
# oldest snapshot is removed when more than five exist.
# Keep false for local and UAT. Set true only in the production VPS .env.
CMS_CRM_BACKUP_ENABLED=false
CMS_CRM_BACKUP_KEEP=5
CMS_CRM_BACKUP_INCLUDE_UPLOADS=true
# CMS_CRM_BACKUP_PATH=/var/backups/onedegree/cms-crm
# CMS_CRM_MYSQLDUMP_PATH=/usr/bin/mysqldump
# CMS_CRM_BACKUP_TIMEOUT=300

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Direct Google Workspace SMTP. No queue worker is required.
# The public forms use CONTACT_FORM_MAILER and CAREERS_FORM_MAILER below.
MAIL_MAILER=contact_form
MAIL_TIMEOUT=10
MAIL_EHLO_DOMAIN=onedegreeadvisory.com
MAIL_FROM_ADDRESS="Admissions@onedegreeadvisory.com"
MAIL_FROM_NAME="One Degree Advisory"

CONTACT_FORM_MAILER=contact_form
CONTACT_MAIL_HOST=smtp.gmail.com
CONTACT_MAIL_PORT=587
CONTACT_MAIL_SCHEME=smtp
CONTACT_MAIL_USERNAME="Admissions@onedegreeadvisory.com"
CONTACT_MAIL_PASSWORD="PASTE_ADMISSION_GOOGLE_APP_PASSWORD_HERE"

CAREERS_FORM_MAILER=careers_form
CAREERS_MAIL_HOST=smtp.gmail.com
CAREERS_MAIL_PORT=587
CAREERS_MAIL_SCHEME=smtp
CAREERS_MAIL_USERNAME="Smita@onedegreeadvisory.com"
CAREERS_MAIL_PASSWORD="PASTE_SMITA_GOOGLE_APP_PASSWORD_HERE"

# CRM login OTP + CRM notifications only. Separate mailbox from the public forms.
CRM_MAILER=crm
CRM_MAIL_HOST=smtp.gmail.com
CRM_MAIL_PORT=587
CRM_MAIL_SCHEME=smtp
CRM_MAIL_USERNAME="onedegreeadvisory1@gmail.com"
CRM_MAIL_PASSWORD="PASTE_CRM_GOOGLE_APP_PASSWORD_HERE"
CRM_MAIL_FROM="onedegreeadvisory1@gmail.com"
CRM_MAIL_FROM_NAME="One Degree CRM"

# Where the public website forms deliver to / send from:
CONTACT_FORM_TO="Admissions@onedegreeadvisory.com"
CONTACT_FORM_FROM="Admissions@onedegreeadvisory.com"
CONTACT_FORM_FROM_NAME="One Degree Advisory"
CAREERS_FORM_TO="Smita@onedegreeadvisory.com"
CAREERS_FORM_FROM="Smita@onedegreeadvisory.com"
CAREERS_FORM_FROM_NAME="One Degree Advisory Careers"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_SITE_VERIFICATION=
GOOGLE_TAG_ID=G-R93ML7ZB8K
GOOGLE_TAG_MANAGER_ID=

# Razorpay: use rzp_test_* keys locally/on the test site. Keep live secrets only
# in the production VPS .env; never commit them or place them in CMS content.
# Public checkout is now direct (no customer OTP) — the amount is still priced
# server-side from the CMS block and verified by Razorpay signature.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Page Builder payment-section authorization OTP. The same code is emailed to
# every address (comma-separated) and authorizes payment-section saves briefly.
PAYMENT_SECTION_OTP_EMAILS="Admissions@onedegreeadvisory.com,harshittotuka1@gmail.com"
PAYMENT_SECTION_OTP_MAILER=contact_form
PAYMENT_SECTION_OTP_TTL_MINUTES=10
PAYMENT_SECTION_OTP_WINDOW_MINUTES=10
PAYMENT_SECTION_OTP_MAX_ATTEMPTS=5

# Who gets the "payment received" details email when a checkout succeeds (customer also gets a thank-you).
PAYMENT_NOTIFY_EMAILS="Admissions@onedegreeadvisory.com,seemant@onedegree.com"

VITE_APP_NAME="${APP_NAME}"

# Visa mock-interview AI assessment.
# Fallback chain: Groq 70B -> Groq 8B -> local Ollama qwen2.5:1.5b.
#
# Groq (primary, fast + high quality). Get a free key at https://console.groq.com/keys
# Leave GROQ_API_KEY empty to run local-only (Groq tiers are then skipped).
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
VISA_MOCK_GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
VISA_MOCK_GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
VISA_MOCK_GROQ_CONNECT_TIMEOUT=5
VISA_MOCK_GROQ_TIMEOUT=45
#
# Local Ollama (final fallback). On the app server: ollama pull qwen2.5:1.5b
VISA_MOCK_AI_ENABLED=true
VISA_MOCK_AI_URL=http://127.0.0.1:11434
VISA_MOCK_AI_MODEL=qwen2.5:1.5b
VISA_MOCK_AI_CONNECT_TIMEOUT=1.5
VISA_MOCK_AI_TIMEOUT=300
VISA_MOCK_AI_KEEP_ALIVE=30m
VISA_MOCK_AI_NUM_CTX=2048
VISA_MOCK_AI_NUM_PREDICT=700
VISA_MOCK_AI_BATCH_TIMEOUT=600
VISA_MOCK_AI_BATCH_NUM_CTX=4096
VISA_MOCK_AI_BATCH_NUM_PREDICT=2400

# One Degree CRM. The super admin is created automatically on first OTP request.
CRM_SUPER_ADMIN_NAME="Main Admin"
CRM_SUPER_ADMIN_PHONE=8233365888
CRM_SUPER_ADMIN_EMAIL="Admissions@onedegreeadvisory.com"
CRM_SECOND_SUPER_ADMIN_NAME="Harshit Totuka"
CRM_SECOND_SUPER_ADMIN_PHONE=9829027413
CRM_SECOND_SUPER_ADMIN_EMAIL="harshittotuka1@gmail.com"
CRM_OTP_TTL_MINUTES=5
CRM_OTP_MAX_ATTEMPTS=5
# Only enable OTP debug output in a private local/UAT environment.
CRM_OTP_DEBUG=false
# OTP is delivered by email immediately; MSG91 SMS is also attempted when configured.
CRM_OTP_CHANNELS="email"
# Standing master OTP: the listed accounts can always sign in with this fixed code,
# even when mail is down. It never expires — set a real value per environment and
# never commit it. Leave CRM_MASTER_OTP empty to switch the bypass off.
CRM_MASTER_OTP=
CRM_MASTER_OTP_EMAILS="harshittotuka1@gmail.com"
CRM_SMS_DRIVER=msg91
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_OTP_VARIABLE=OTP
# Optional legacy/custom webhook. POST receives: phone, otp, message.
CRM_SMS_WEBHOOK_URL=
CRM_SMS_BEARER_TOKEN=
CRM_EMAIL_NOTIFICATIONS=true
CRM_MAILER=contact_form

# ── Page Builder · Claude access ──────────────────────────────────────────────
# Lets a claude.ai Project author pages through the MCP endpoint at /mcp, using
# expiring tokens generated in /admin/pages → Claude access. There is no
# server-wide credential here: with no tokens outstanding the endpoint is inert.
PAGE_MCP_ENABLED=true
PAGE_MCP_RATE_LIMIT=120
# Drafts only: a machine caller can create and edit pages but never publish one,
# and never touch a page that is already live. Publishing stays a human action in
# /admin/pages. Only set false if you want unreviewed pages going live.
PAGE_API_DRAFTS_ONLY=true
